const scriptURL = 'https://script.google.com/u/0/home/projects/1gvjX9XyYC8a-K0_Ic_lzwIEHz2j6r0k2CSO2Um89pSqLuoTl0pmOWTdf';
const form = document.getElementById('myForm');
const statusDiv = document.getElementById('status');

form.addEventListener('submit', e => {
  e.preventDefault();
  statusDiv.textContent = "Mengirim data...";

  // Data yang ingin dikirim ke Google Sheets / Drive
  const data = {
    nama: document.getElementById('nama').value,
    email: document.getElementById('email').value,
    pesan: document.getElementById('pesan').value
  };

  fetch(scriptURL, {
    method: 'POST',
    mode: 'no-cors', // Diperlukan karena kebijakan CORS Google Apps Script
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(() => {
    statusDiv.textContent = "Data berhasil dikirim!";
    form.reset();
  })
  .catch(error => {
    statusDiv.textContent = "Terjadi kesalahan: " + error;
  });
});
